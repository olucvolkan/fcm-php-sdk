{
  "name": "volk/php-firebase-cloud-messaging",
  "description": "Firebase Cloud Messaging (FCM) SDK for PHP applications",
  "keywords": [
    "firebase",
    "fcm",
    "notifications",
    "push-notifications",
    "php",
    "laravel",
    "symfony"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Volkan Oluç",
      "email": "volkanoluc@gmail.com"
    }
  ],
  "type": "library",
  "require": {
    "php": ">=7.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^6.0|^7.0|^8.0|^9.0",
    "illuminate/support": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0",
    "illuminate/notifications": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0"
  },
  "suggest": {
    "illuminate/support": "Required for Laravel integration (^5.5)",
    "illuminate/notifications": "Required for Laravel notifications integration (^5.5)"
  },
  "autoload": {
    "psr-4": {
      "Firebase\\CloudMessaging\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Firebase\\CloudMessaging\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Firebase\\CloudMessaging\\Laravel\\FCMServiceProvider"
      ],
      "aliases": {
        "FCM": "Firebase\\CloudMessaging\\Laravel\\Facades\\FCM"
      }
    }
  },
  "minimum-stability": "stable"
}